# ================ DATABASE ================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=db_bookwise
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ================ EMAIL (Mailjet via django-anymail) ================
# Leave EMAIL_BACKEND unset in dev to print emails to the console.
# To send real emails (dev or prod), set the backend and your Mailjet keys:
# EMAIL_BACKEND=anymail.backends.mailjet.EmailBackend
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
DEFAULT_FROM_EMAIL=BookWise <you@yourdomain.com>

# ================ DJANGO ================
SECRET_KEY=your_django_secret_key

# ================ PRODUCTION (Render + Neon) ================
# In production, config/settings/prod.py reads a single DATABASE_URL instead of
# the discrete DB_* vars above. Get this from your Neon dashboard, e.g.:
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech:5432/dbname?sslmode=require
# ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS are optional comma-separated extras;
# your *.onrender.com host is detected automatically.
